{
  "$schema": "https://developer.microsoft.com/json-schemas/copilot/plugin/v2.2/schema.json",
  "schema_version": "v2.2",
  "name_for_human": "iOFFICE Tickets",
  "namespace": "ioffice",
  "description_for_human": "Look up iOFFICE service request categories and create service request tickets.",
  "description_for_model": "Use listCategories to get the valid iOFFICE service request categories before choosing one. Use createServiceRequest to create a ticket only after the user has confirmed the draft.",
  "functions": [
    {
      "name": "listCategories",
      "description": "Returns the iOFFICE service request categories, each with an id, a name, a description of what belongs in it, and its parent category.",
      "capabilities": {
        "response_semantics": {
          "data_path": "$",
          "properties": {
            "title": "$.name",
            "subtitle": "$.parent.name"
          }
        }
      }
    },
    {
      "name": "createServiceRequest",
      "description": "Creates an iOFFICE service request ticket in the given category. Call only after the user confirms the ticket details.",
      "capabilities": {
        "confirmation": {
          "type": "AdaptiveCard",
          "title": "Create this iOFFICE ticket?",
          "body": "**Subject:** {{function.parameters.subject}}\n\n**Priority:** {{function.parameters.priority}}\n\n**Location:** {{function.parameters.location}}"
        },
        "response_semantics": {
          "data_path": "$",
          "properties": {
            "title": "$.id",
            "subtitle": "$.category.name"
          },
          "static_template": {
            "type": "AdaptiveCard",
            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
            "version": "1.5",
            "body": [
              {
                "type": "TextBlock",
                "text": "iOFFICE ticket ${id} created",
                "weight": "Bolder",
                "size": "Medium",
                "wrap": true
              },
              {
                "type": "FactSet",
                "facts": [
                  { "title": "Category", "value": "${category.name}" },
                  { "title": "Subject", "value": "${subject}" },
                  { "title": "Priority", "value": "${priority}" },
                  { "title": "Status", "value": "${status.name}" }
                ]
              }
            ],
            "actions": [
              {
                "type": "Action.OpenUrl",
                "title": "Open in iOFFICE",
                "url": "${{IOFFICE_TICKET_URL_PREFIX}}${id}"
              }
            ]
          }
        }
      }
    }
  ],
  "runtimes": [
    {
      "type": "OpenApi",
      "auth": {
        "type": "ApiKeyPluginVault",
        "reference_id": "${{IOFFICE_API_KEY_REGISTRATION_ID}}"
      },
      "spec": {
        "url": "apiSpecificationFile/openapi.yaml"
      },
      "run_for_functions": [
        "listCategories",
        "createServiceRequest"
      ]
    }
  ]
}
