{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "Your Organization",
    "websiteUrl": "https://www.example.com",
    "privacyUrl": "https://www.example.com/privacy",
    "termsOfUseUrl": "https://www.example.com/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "iOFFICE Tickets${{APP_NAME_SUFFIX}}",
    "full": "iOFFICE Ticket Assistant"
  },
  "description": {
    "short": "Turn emails into iOFFICE service requests.",
    "full": "A Copilot agent that reads an email, matches it to the right iOFFICE service request category, and creates the ticket after you confirm."
  },
  "accentColor": "#005A9E",
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "iofficeTicketAgent",
        "file": "declarativeAgent.json"
      }
    ]
  },
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": []
}
