# Non-secret settings for the "dev" environment.
# Do NOT put the iOFFICE password or API key here: it goes in env/.env.dev.user
# (git-ignored) as SECRET_IOFFICE_API_KEY, or straight into the Teams Developer Portal.
TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev

# Your iOFFICE REST API base address. TODO: confirm with your iOFFICE admin.
IOFFICE_API_BASE_URL=https://REPLACE-ME.iofficeconnect.com/external/api/rest/v2

# Header that carries the secret (password or API token). TODO: confirm.
IOFFICE_AUTH_HEADER=x-auth-password

# Integration user's username, sent as the x-auth-username header (not secret).
# If your instance uses a single API token, remove AuthUsername from openapi.yaml.
IOFFICE_USERNAME=REPLACE-ME

# Start of a link to a ticket in the iOFFICE web app; the ticket id is added to the end.
IOFFICE_TICKET_URL_PREFIX=https://REPLACE-ME.iofficeconnect.com/

# Filled in by the toolkit when you provision (or paste them in if you register by hand):
TEAMS_APP_ID=
IOFFICE_API_KEY_REGISTRATION_ID=
M365_TITLE_ID=
M365_APP_ID=
