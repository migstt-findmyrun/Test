# Non-secret settings for the "dev" environment. Do NOT put passwords here.
TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev

# Public HTTPS address of the bridge API (api/server.js), e.g. your dev tunnel URL.
# Copilot calls the API from Microsoft's cloud, so http://localhost will not work.
OPENAPI_SERVER_URL=https://REPLACE-ME.devtunnels.ms

# Filled in by the toolkit when you provision:
TEAMS_APP_ID=
M365_TITLE_ID=
M365_APP_ID=
